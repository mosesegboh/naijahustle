# Copy to .env in the project root. Never commit real credentials.
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=naija_hustle
WEB_ORIGIN=http://localhost:5173
PORT=3001
# Heroku supplies PORT. Set NODE_ENV=production and WEB_ORIGIN=https://your-app-domain
# in Heroku Config Vars; use a hosted MongoDB URI there.

# Advertising checkout (server-only). Test keys never publish live adverts.
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_ADS_ENABLED=false
# Existing account IDs only; obtain after verifying the intended admin username.
ADMIN_USER_IDS=
