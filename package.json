{
  "name": "naija-hustle",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run build -w @naija-hustle/web",
    "typecheck": "npm run typecheck -w @naija-hustle/web",
    "test": "vitest run",
    "test:browser": "playwright test",
    "preview": "npm run preview -w @naija-hustle/web --",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dev:server": "npm run dev -w @naija-hustle/server",
    "dev:web": "npm run dev -w @naija-hustle/web --",
    "start": "node --env-file-if-exists=.env --experimental-strip-types apps/server/index.mjs",
    "test:smoke": "node scripts/smoke.mjs"
  },
  "devDependencies": {
    "vitest": "^3.2.4",
    "@playwright/test": "^1.56.0",
    "prettier": "^3.6.2"
  },
  "overrides": {
    "react": "19.2.7",
    "react-dom": "19.2.7"
  }
}
